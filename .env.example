# Copie para .env na raiz. Este arquivo contém somente exemplos locais.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
# Origens exatas, separadas por vírgula; sem barra final ou curingas.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Docker local. Defina uma senha local e mantenha-a fora do Git.
POSTGRES_DB=apex_ride
POSTGRES_USER=apex_ride
POSTGRES_PASSWORD=troque_por_uma_senha_local
POSTGRES_PORT=55432
# Use a mesma senha acima; caracteres especiais na URL exigem percent-encoding.
DATABASE_URL=postgresql://apex_ride:troque_por_uma_senha_local@127.0.0.1:55432/apex_ride
# disable: permitido somente em loopback local; verify-full: TLS com CA confiável.
DATABASE_SSL=disable

# Vite lê somente variáveis VITE_ para o código do navegador. Nunca adicione segredos.
VITE_API_BASE_URL=/api
# Parte 05: estilo MapLibre; provedor externo recebe a região visualizada.
# Padrão OpenFreeMap Dark, sem chave. Preserve as atribuições do estilo.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark
# Somente desenvolvimento: destino do proxy /api; não é exposto ao navegador.
WEB_API_PROXY_TARGET=http://127.0.0.1:3001

# Parte 03 — somente backend. Use sempre a mesma origem no navegador e nos links.
AUTH_WEB_ORIGIN=http://127.0.0.1:5173
AUTH_SESSION_HOURS=168
# false: cadastro permite login imediatamente. true: confirmação por e-mail obrigatória.
AUTH_REQUIRE_EMAIL_VERIFICATION=false
# test: provedor em memória exclusivo de desenvolvimento/testes, sem envio externo.
# production exige smtp; configure remetente validado e serviço antes do lançamento.
MAIL_MODE=test
MAIL_FROM=Apex Ride <no-reply@example.invalid>
SMTP_HOST=
SMTP_PORT=587
# true para TLS implícito (normalmente porta 465); false exige STARTTLS.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Ciência preliminar para testes. Substitua URLs e versões por documentos revisados.
# production recusa estas versões preliminares; não representa adequação à LGPD.
TERMS_VERSION=prelaunch-draft
PRIVACY_VERSION=prelaunch-draft
TERMS_URL=/documentos
PRIVACY_URL=/documentos
# Opcional, somente para testes: conexão de banco com permissão CREATE SCHEMA.
# TEST_DATABASE_URL=postgresql://usuario:senha@127.0.0.1:55432/apex_ride

# Parte 04 — somente backend; padrão: <raiz>/.local/motorcycle-photos (persistente).
# Para alterar, use caminho ABSOLUTO para diretório privado dedicado, fora de apps/.
# Nunca configure como pasta pública ou sirva os arquivos diretamente pelo proxy.
# MOTORCYCLE_STORAGE_DIR=D:/Dados/ApexRide/motorcycle-photos
# Parte 18 reutiliza esse volume: fotografias sociais ficam no subdiretório social/.
# Ele também deve ser privado, persistente e servido apenas pelos endpoints autorizados.
# Roteamento OSRM contratado ou próprio. Vazio = indisponível, sem fallback reto.
ROUTING_OSRM_URL=
ROUTING_OSRM_PROFILE=driving
# Token opcional enviado somente pelo backend como Authorization: Bearer.
ROUTING_OSRM_TOKEN=
# Etapa 4: geocodificação MapTiler, credencial SOMENTE no backend.
# Ative apenas após autorização contratual, quotas e privacidade revisadas pelo operador.
GEOCODING_MAPTILER_KEY=
GEOCODING_AUTHORIZED=false
# Parte 14. Limite detalhado entre 2 e 4; grupos comunitários nunca abaixo de 10.
COMPARISON_MAX_ACTIVITIES=4
COMPARISON_MIN_PARTICIPANTS=10
# Chave AES-256 (64 caracteres hex), somente servidor; configure antes de provisionar admin.
# Gerar fora de logs e guardar em secret manager. Sem chave, MFA administrativo fica indisponível.
ADMIN_MFA_KEY=
