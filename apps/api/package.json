{
  "name": "@apex-ride/api",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node --import tsx src/migrate-cli.ts",
    "test:postgres": "node --import tsx test/postgres-runner.ts",
    "test:recovery": "node --import tsx test/recovery-runner.ts",
    "similarity:regions": "node --import tsx src/similarity-regions-cli.ts",
    "gamification:reconcile": "node --import tsx src/gamification-cli.ts",
    "admin:bootstrap": "node --import tsx src/admin-cli.ts"
  },
  "dependencies": {
    "@apex-ride/ride-core": "workspace:*",
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "fastify": "5.12.7",
    "nodemailer": "10.2.0",
    "otpauth": "9.4.1",
    "pg": "8.23.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
