    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/geojson": "7946.0.16",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.6",
    "jsdom": "30.1.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
